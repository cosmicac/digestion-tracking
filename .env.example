# Shared password used to log in
APP_PASSWORD=change-me

# Random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab name inside the spreadsheet (created automatically if missing)
GOOGLE_SHEET_TAB=Events

# Full service account JSON key, either raw JSON on one line or base64-encoded
GOOGLE_SERVICE_ACCOUNT_JSON=

# Port for the API server (Railway sets this automatically)
PORT=3001
